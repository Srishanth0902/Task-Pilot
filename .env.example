# Copy this file to .env and adjust if needed:
#   cp .env.example .env
#
# Every value below has a working default, so an empty .env is fine.
# Never commit the real .env — it is listed in .gitignore.

# OAuth client secret downloaded from Google Cloud Console
# (APIs & Services > Credentials > OAuth client ID, type "Desktop app").
# Path is relative to the project root.
GOOGLE_CREDENTIALS_FILE=credentials.json

# Where the cached OAuth token is written after the first successful login.
# Created automatically — do not create it by hand, and never commit it.
GOOGLE_TOKEN_FILE=token.json

# Which calendar to operate on. "primary" is the signed-in user's main calendar.
# You can also paste a specific calendar ID (looks like an email address).
GOOGLE_CALENDAR_ID=primary

# IANA timezone used when creating events.
# Examples: Asia/Kolkata, America/New_York, Europe/London, UTC
TIMEZONE=Asia/Kolkata

# Working hours used for free-slot suggestions (24-hour clock).
WORKDAY_START_HOUR=8
WORKDAY_END_HOUR=21

# OpenRouter exposes supported models through an OpenAI-compatible API.
# Create a key at https://openrouter.ai/keys and keep it only in .env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-30b-a3b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# FastAPI backend and Streamlit-to-backend connection.
API_HOST=127.0.0.1
API_PORT=8000
TASK_PILOT_API_URL=http://127.0.0.1:8000

# Local rotating JSON logs. Keep this directory private and out of Git.
LOG_LEVEL=INFO
LOG_FILE=logs/task_pilot.jsonl
LOG_MAX_BYTES=2000000
LOG_BACKUP_COUNT=3
